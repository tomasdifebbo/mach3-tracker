# Servidor HTTP & Banco de Dados
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://usuario:senha@host:5432/mach3tracker

# Autenticação JWT (OBRIGATÓRIO em produção com >= 16 caracteres aleatórios)
JWT_SECRET=substitua-por-uma-chave-secreta-longa-e-aleatoria
MASTER_EMAILS=tomasdifebbo.tdf@gmail.com,admin@mach3.com,casadotrem@gmail.com
INITIAL_ADMIN_PASSWORD=

# Sincronização segura do robô local (assistente_pastas / kanban_watcher)
OFICINA_SYNC_KEY=
OFICINA_SYNC_USER_ID=1

# Parametrização Multi-Tenant opcional (fallback quando não configurado na UI em Configurações)
PIPELINE_LOCAL_ROOT=
PIPELINE_ONEDRIVE_ROOT=
DEFAULT_DAY_OPERATOR=Operador
DEFAULT_NIGHT_OPERATOR=Operador Noite

# CORS adicional em produção (separado por vírgula)
CORS_ORIGINS=https://mach3-tracker.onrender.com,https://mach3tracker.up.railway.app

# Web Push (PWA - gere um par via `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:contato@mach3tracker.com

# Mercado Pago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# E-mail SMTP (Gmail App Password para relatórios e recuperação de senha)
EMAIL_USER=
EMAIL_PASS=
